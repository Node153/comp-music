NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Cloudflare R2 (posts 버킷용 스토리지 — Cloudflare 대시보드 > R2 > Manage R2 API Tokens에서 발급)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# GIPHY (DEMO 커버 이미지로 GIF 선택 — developers.giphy.com에서 앱 등록 후 API key 발급)
# NEXT_PUBLIC_ 접두사가 붙는 이유: GIPHY 픽커는 브라우저에서 직접 검색 API를 호출하는 구조라
# (GIPHY 공식 SDK도 동일한 방식) 이 키는 원래부터 클라이언트에 노출되는 걸 전제로 한다.
NEXT_PUBLIC_GIPHY_API_KEY=

# Resend (알림 이메일 하루 1회 다이제스트 발송 — resend.com에서 API key 발급)
RESEND_API_KEY=

# Sentry 에러 모니터링 (sentry.io에서 프로젝트 생성 후 발급)
# - NEXT_PUBLIC_SENTRY_DSN: 이 값이 있어야 Sentry가 켜진다. 없으면 SDK 전부 no-op.
#   보통 프로덕션(Vercel) 환경에만 넣고 로컬엔 비워둔다. DSN은 공개돼도 안전한 값.
# - 아래 3개는 빌드 시 소스맵 업로드용(Vercel 환경변수에만). 없으면 업로드만 스킵됨.
#   SENTRY_AUTH_TOKEN은 비밀값 — sentry.io > Settings > Auth Tokens에서 발급.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
